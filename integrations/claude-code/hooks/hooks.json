{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mohar",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mohar",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mohar",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 900
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mohar",
            "args": [
              "hook",
              "claude-code"
            ],
            "timeout": 900
          }
        ]
      }
    ]
  }
}
